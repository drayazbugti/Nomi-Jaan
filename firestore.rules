rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCloudRecord(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 60 &&
             data.payload is string &&
             data.payload.size() >= 1 &&
             data.payload.size() <= 4000 &&
             data.appTag is string &&
             data.appTag.size() >= 1 &&
             data.appTag.size() <= 40 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/cloud_records/{recordId} {
      allow get: if isOwner(userId) && isValidId(recordId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(recordId) &&
                       incoming().keys().hasAll(['userId', 'title', 'category', 'payload', 'appTag', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'category', 'payload', 'appTag', 'createdAt', 'updatedAt']) &&
                       isValidCloudRecord(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(recordId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidCloudRecord(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'payload', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(recordId);
    }
  }
}
